<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenAorus.Hardware\OpenAorus.Hardware.csproj" />
    <!-- AppServices is the one piece of startup orchestration that cannot live in the hardware
         library; referenced here so its read-only/lighting behaviour is covered like the rest. -->
    <ProjectReference Include="..\..\src\OpenAorus.App\OpenAorus.App.csproj" />
  </ItemGroup>

  <!-- The recovered key orders are test data: KeyLayoutTests compares the C# arrays
       against these files rather than against a hand-copied subset. -->
  <ItemGroup>
    <None Include="..\..\docs\research\ione-keymap-eng-*.txt" CopyToOutputDirectory="PreserveNewest" Link="keymaps\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The recovered schema and the known-good reading are test data, for the same reason the
       keymaps are: the generator is compared against the file it claims to come from, and the
       gate is compared against the one reading we know was correct. -->
  <ItemGroup>
    <None Include="..\..\docs\research\gb-wmiacpi-methods-aorus-17g-kd.txt" CopyToOutputDirectory="PreserveNewest" Link="schema\%(Filename)%(Extension)" />
    <None Include="..\..\docs\research\dump-aorus-17g-kd-known-good.txt" CopyToOutputDirectory="PreserveNewest" Link="schema\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The markup is test data too. XamlResourceTests reads it as plain XML - no WPF, no
       Application, no STA thread - because a StaticResource key typo compiles cleanly and
       only throws when the panel is first shown. -->
  <ItemGroup>
    <None Include="..\..\src\OpenAorus.App\Views\*.xaml" CopyToOutputDirectory="PreserveNewest" Link="xaml\Views\%(Filename)%(Extension)" />
    <None Include="..\..\src\OpenAorus.App\Themes\Dark.xaml" CopyToOutputDirectory="PreserveNewest" Link="xaml\Themes\%(Filename)%(Extension)" />
    <None Include="..\..\src\OpenAorus.App\Converters.cs" CopyToOutputDirectory="PreserveNewest" Link="xaml\Converters.cs.txt" />
  </ItemGroup>

</Project>