<UserControl x:Class="OpenAorus.App.Views.LightingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:OpenAorus.App"
             xmlns:views="clr-namespace:OpenAorus.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <app:EnumEqualsVisibilityConverter x:Key="EnumVis"/>
        <DataTemplate x:Key="SwatchTemplate">
            <Border Width="52" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource ControlBorder}">
                <Border.Background><SolidColorBrush Color="{Binding}"/></Border.Background>
            </Border>
        </DataTemplate>
        <!-- Every parameter row is the same four columns, so the labels line up down the left
             and the controls line up down the middle whichever effect is showing. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="74"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </UserControl.Resources>

    <StackPanel IsEnabled="{Binding KeyboardPresent}" Grid.IsSharedSizeScope="True">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding DeviceLine}" Margin="0,0,0,10"/>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LightLabel"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Effect"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Apply" Margin="8,0,0,0"
                            Command="{Binding ApplyEffectCommand}"/>
                </Grid>

                <!-- Each parameter row is bound to the flag for the effect that uses it, so an
                     effect that ignores speed or direction simply does not offer the control. -->
                <Grid Style="{StaticResource Row}" Visibility="{Binding SupportsColor, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LightLabel"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Colour"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Swatches}" SelectedItem="{Binding PickedColor}"
                              ItemTemplate="{StaticResource SwatchTemplate}" ToolTip="Pick a colour"/>
                    <!-- PropertyChanged so the view model sees the value as it is typed, which is
                         what its half-typed-value guard is written against. -->
                    <TextBox Grid.Column="2" Width="92" Margin="8,0,0,0"
                             Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Or type it as #RRGGBB"/>
                    <Border Grid.Column="3" Width="30" Height="30" Margin="8,0,0,0" CornerRadius="6"
                            BorderThickness="1" BorderBrush="{StaticResource ControlBorder}">
                        <Border.Background><SolidColorBrush Color="{Binding PickedColor}"/></Border.Background>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource Row}" Visibility="{Binding SupportsSecondColor, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LightLabel"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Second"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Swatches}" SelectedItem="{Binding PickedSecondColor}"
                              ItemTemplate="{StaticResource SwatchTemplate}" ToolTip="Pick a colour"/>
                    <TextBox Grid.Column="2" Width="92" Margin="8,0,0,0"
                             Text="{Binding SecondColorHex, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Or type it as #RRGGBB"/>
                    <Border Grid.Column="3" Width="30" Height="30" Margin="8,0,0,0" CornerRadius="6"
                            BorderThickness="1" BorderBrush="{StaticResource ControlBorder}">
                        <Border.Background><SolidColorBrush Color="{Binding PickedSecondColor}"/></Border.Background>
                    </Border>
                </Grid>

                <Grid Style="{StaticResource Row}" Visibility="{Binding SupportsSpeed, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LightLabel"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Speed"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding SpeedPercent}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding SpeedPercent, StringFormat={}{0}%}"/>
                </Grid>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LightLabel"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Brightness"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding BrightnessPercent}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding BrightnessPercent, StringFormat={}{0}%}"/>
                </Grid>

                <Grid Style="{StaticResource Row}" Visibility="{Binding SupportsDirection, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LightLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Direction"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}"/>
                </Grid>

                <CheckBox Content="Let the effect pick its own colours" IsChecked="{Binding Random}" Margin="0,2,0,0"
                          Visibility="{Binding SupportsRandom, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Border>

        <!-- Per-key editor: only the Custom effect has colours of its own to edit. -->
        <Border Style="{StaticResource CardStyle}"
                Visibility="{Binding SelectedEffect, Converter={StaticResource EnumVis}, ConverterParameter=Custom}">
            <views:KeyboardCanvas x:Name="PerKeyHost" DataContext="{Binding PerKey}"/>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Presets"/>
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Name and delete are one chip: a rounded well holding the two
                                 buttons, so the × belongs to the preset it removes rather than
                                 floating beside it as an equal. -->
                            <Border Margin="0,0,6,6" CornerRadius="6" Background="{StaticResource Control}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Name}" Background="Transparent"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="✕" Style="{StaticResource RemoveButton}" ToolTip="Delete this preset"
                                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Save current as preset" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Command="{Binding SavePresetCommand}"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                   Margin="2,0,0,0"/>
    </StackPanel>
</UserControl>
