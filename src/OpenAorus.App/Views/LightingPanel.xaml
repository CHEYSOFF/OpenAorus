<UserControl x:Class="OpenAorus.App.Views.LightingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:OpenAorus.App"
             xmlns:views="clr-namespace:OpenAorus.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <app:EnumEqualsVisibilityConverter x:Key="EnumVis"/>
        <DataTemplate x:Key="SwatchTemplate">
            <Border Width="46" Height="12" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource CardBorder}">
                <Border.Background><SolidColorBrush Color="{Binding}"/></Border.Background>
            </Border>
        </DataTemplate>
        <!-- The theme paints every TextBlock light, which is right everywhere except inside a
             ComboBox: those keep the system's light chrome, and the effect name came out white on
             white. An ItemTemplate covers the closed selection box as well as the open list. -->
        <DataTemplate x:Key="ComboText">
            <TextBlock Text="{Binding}" Foreground="{StaticResource AccentFg}"/>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel IsEnabled="{Binding KeyboardPresent}">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding DeviceLine}" Margin="0,0,0,6"/>

                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Apply" Margin="6,0,0,0" Command="{Binding ApplyEffectCommand}"/>
                    <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}"
                              ItemTemplate="{StaticResource ComboText}"/>
                </DockPanel>

                <!-- Each parameter row is bound to the flag for the effect that uses it, so an
                     effect that ignores speed or direction simply does not offer the control. -->
                <DockPanel Margin="0,0,0,6" Visibility="{Binding SupportsColor, Converter={StaticResource BoolVis}}">
                    <TextBlock DockPanel.Dock="Left" Width="70" VerticalAlignment="Center" Text="Colour"/>
                    <!-- PropertyChanged so the view model sees the value as it is typed, which is
                         what its half-typed-value guard is written against. -->
                    <TextBox DockPanel.Dock="Right" Width="76" Margin="6,0,0,0"
                             Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Or type it as #RRGGBB"/>
                    <ComboBox ItemsSource="{Binding Swatches}" SelectedItem="{Binding PickedColor}"
                              ItemTemplate="{StaticResource SwatchTemplate}"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6" Visibility="{Binding SupportsSecondColor, Converter={StaticResource BoolVis}}">
                    <TextBlock DockPanel.Dock="Left" Width="70" VerticalAlignment="Center" Text="Second"/>
                    <TextBox DockPanel.Dock="Right" Width="76" Margin="6,0,0,0"
                             Text="{Binding SecondColorHex, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Or type it as #RRGGBB"/>
                    <ComboBox ItemsSource="{Binding Swatches}" SelectedItem="{Binding PickedSecondColor}"
                              ItemTemplate="{StaticResource SwatchTemplate}"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6" Visibility="{Binding SupportsSpeed, Converter={StaticResource BoolVis}}">
                    <TextBlock DockPanel.Dock="Left" Width="70" Text="Speed"/>
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="{Binding SpeedPercent, StringFormat={}{0}%}"/>
                    <Slider Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding SpeedPercent}"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Width="70" Text="Brightness"/>
                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="{Binding BrightnessPercent, StringFormat={}{0}%}"/>
                    <Slider Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding BrightnessPercent}"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6" Visibility="{Binding SupportsDirection, Converter={StaticResource BoolVis}}">
                    <TextBlock DockPanel.Dock="Left" Width="70" VerticalAlignment="Center" Text="Direction"/>
                    <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}"
                              ItemTemplate="{StaticResource ComboText}"/>
                </DockPanel>

                <CheckBox Content="Let the effect pick its own colours" IsChecked="{Binding Random}"
                          Visibility="{Binding SupportsRandom, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Border>

        <!-- Per-key editor: only the Custom effect has colours of its own to edit. -->
        <Border Style="{StaticResource CardStyle}"
                Visibility="{Binding SelectedEffect, Converter={StaticResource EnumVis}, ConverterParameter=Custom}">
            <views:KeyboardCanvas x:Name="PerKeyHost" DataContext="{Binding PerKey}"/>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Presets" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="×" Padding="6,5" Margin="2,0,0,0" ToolTip="Delete this preset"
                                        Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Save current as preset" HorizontalAlignment="Left" Command="{Binding SavePresetCommand}"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</UserControl>
