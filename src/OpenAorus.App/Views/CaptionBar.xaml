<UserControl x:Class="OpenAorus.App.Views.CaptionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenAorus.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <!-- Painted in the window ground rather than a shade off it: a caption that reads
         as a separate strip is the very thing this replaces. The rule that divides
         chrome from content sits at the foot of the window, where the footer already
         carries one; a second one up here would fence in a window this small. -->
    <Grid Height="{StaticResource CaptionHeight}" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- The window's own Title, so it is still set in one place and alt-tab has it. -->
        <TextBlock Grid.Column="0" Margin="16,0,8,0" VerticalAlignment="Center"
                   Style="{StaticResource CaptionTitle}" TextTrimming="CharacterEllipsis"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

        <!-- WPF reads a string ToolTip back as the automation HelpText, so the hint on
             Close reaches a screen reader as well as the pointer. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                    Click="Minimise_Click" ToolTip="Minimise"
                    AutomationProperties.Name="Minimise"
                    Visibility="{Binding CanMinimise, Converter={StaticResource BoolVis},
                                 RelativeSource={RelativeSource AncestorType={x:Type views:CaptionBar}}}"/>
            <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                    Click="Close_Click" AutomationProperties.Name="Close"
                    ToolTip="{Binding CloseHint,
                              RelativeSource={RelativeSource AncestorType={x:Type views:CaptionBar}}}"/>
        </StackPanel>
    </Grid>
</UserControl>
