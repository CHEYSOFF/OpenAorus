<Window x:Class="OpenAorus.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenAorus.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource AppWindow}"
        Title="OpenAorus settings" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Same frame treatment as the main window; see MainWindow.xaml for why it is done
         this way. NoResize, so no minimise button - which is what the Windows frame gave
         this dialog too. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{StaticResource CaptionHeight}"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0,0,0,1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <DockPanel>
        <!-- Outside the IsEnabled scope below on purpose: on a model this app cannot write
             to, everything in the dialog is disabled, and a close button that went with it
             would leave the owner in a modal dialog with no way out of it. -->
        <views:CaptionBar DockPanel.Dock="Top" CanMinimise="False"/>
        <StackPanel DockPanel.Dock="Top" Margin="16,8,16,0" IsEnabled="{Binding CanWrite}">
            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Toggle" VerticalAlignment="Center" Margin="12,0,0,0"
                            Command="{Binding ToggleStartupCommand}"/>
                    <StackPanel>
                        <CheckBox Content="Start with Windows (no UAC prompt)" IsChecked="{Binding StartWithWindows, Mode=OneWay}" IsHitTestVisible="False"/>
                        <TextBlock Style="{StaticResource Body}" Margin="25,4,0,0"
                                   Text="Creates a logon task that runs OpenAorus elevated in the tray."/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Toggle" VerticalAlignment="Center" Margin="12,0,0,0"
                            Command="{Binding ToggleTakeoverCommand}"/>
                    <StackPanel>
                        <CheckBox Content="Take over from Gigabyte Control Center" IsChecked="{Binding GccTakenOver, Mode=OneWay}" IsHitTestVisible="False"/>
                        <TextBlock Style="{StaticResource Body}" Margin="25,4,0,0"
                                   Text="Disables GCC's logon task, AorusFusion autostart and SMV4_Service, and closes GCC processes. Reversible. GCC stays installed so its WMI schema keeps working."/>
                        <TextBlock Text="GCC is currently running." Foreground="{StaticResource Warn}" Margin="25,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GccActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Sensor polling"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Muted}" Text="Window open (ms)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PollVisibleMs}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Muted}" Text="In tray (ms)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PollHiddenMs}"/>
                        </StackPanel>
                        <Button Content="Save" VerticalAlignment="Bottom" Command="{Binding SaveIntervalsCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- A sibling of the CanWrite panel above, never a child of it. Touchpad, Wi-Fi and
             keyboard backlight need no WMI at all, so gating this card would take three working
             features away on an unrecognised model to protect the one - fan cycling - that does
             not work there, and which the fan controller already refuses with a message of its
             own. HotkeySettingsUiTests pins the arrangement, because "outside the gate" is a
             fact about where the markup sits and nothing in it says so.

             The settings path and the status line move out of the gate with it: they are text
             the owner reads, and the hotkey card's own Save writes to that status line - a
             message about a card that works, greyed out because a different card does not, would
             be the gate reaching this one by the back door. -->
        <StackPanel Margin="16,0,16,14">
            <!-- Outside the CanWrite panel, and a sibling of it rather than a child, for a sharper
                 reason than the hotkey card below: this is the card that fixes the condition
                 disabling everything above it, and greying it out would leave the owner in a modal
                 dialog whose only working control is the one that cannot help them.
                 SchemaSettingsUiTests pins the arrangement, because "outside the gate" is a fact
                 about where the markup sits and nothing in it says so. -->
            <Border Style="{StaticResource CardStyle}" DataContext="{Binding Schema}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Gigabyte WMI interface"/>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                               Text="Fan and battery control go through an interface description that Gigabyte Control Center used to install, and that uninstalling Control Center takes away with it. OpenAorus can register its own copy. It needs administrator rights, and Remove puts the machine back exactly as it was."/>

                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="{Binding StatusText}"/>

                    <TextBlock Text="OpenAorus is not running as administrator, so it can neither register nor remove anything."
                               Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsElevation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Each button is shown only where the state machine permits that action:
                         never Install over a registration somebody else made, never Remove of
                         classes carrying Gigabyte's names, and never a hardware check against a
                         machine with no working registration on it to check. Registering and
                         proving are two separate things, so what is offered after a successful
                         install is "Check it works" rather than another Install - and on a
                         Control Center machine, where the other two are refused and always will
                         be, "Check it works" is the only button and the only one needed. -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Register the interface" Margin="0,0,8,0"
                                Command="{Binding InstallCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanInstall}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Check it works" Margin="0,0,8,0"
                                Command="{Binding RunGatesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanRunGates}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Remove" Command="{Binding RemoveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanRemove}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource Fg}" Text="{Binding Message}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" DataContext="{Binding Hotkeys}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Fn hotkeys"/>
                    <CheckBox Content="Respond to the Fn row" IsChecked="{Binding HotkeysEnabled}"/>
                    <TextBlock Style="{StaticResource Body}" Margin="25,4,0,0"
                               Text="Cycles the fan mode, follows the keyboard backlight, reports the touchpad and Wi-Fi keys, and changes the screen brightness. Volume is left to Windows, which already draws an overlay for it."/>

                    <!-- Disabled rather than hidden while the Fn row is off, so the owner can see
                         what turning it back on would give them. The heading dims with the five
                         switches it heads; the Save button below stays live, because switching
                         the Fn row off is itself a thing that has to be saveable. -->
                    <StackPanel IsEnabled="{Binding HotkeysEnabled}">
                        <TextBlock Style="{StaticResource GroupLabel}" Text="Show an overlay for" Margin="2,14,0,8"/>
                        <UniformGrid Columns="2">
                            <CheckBox Content="Fan mode" Margin="0,0,8,9"
                                      IsChecked="{Binding OverlayForFanMode}"/>
                            <CheckBox Content="Keyboard backlight" Margin="0,0,0,9"
                                      IsChecked="{Binding OverlayForBacklight}"/>
                            <CheckBox Content="Touchpad" Margin="0,0,8,9"
                                      IsChecked="{Binding OverlayForTouchpad}"/>
                            <CheckBox Content="Wi-Fi" Margin="0,0,0,9"
                                      IsChecked="{Binding OverlayForWifi}"/>
                            <!-- The only one that starts ticked. This laptop's firmware reports
                                 the brightness keys without acting on them, so OpenAorus makes the
                                 change itself - and because that change never goes through
                                 Windows' hotkey path, Windows draws nothing for it. Untick it and
                                 the keys still work, silently. -->
                            <CheckBox Content="Screen brightness" Margin="0,0,8,0"
                                      IsChecked="{Binding OverlayForPanelBrightness}"/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Muted}" Margin="2,2,0,0" TextWrapping="Wrap"
                                   Text="Screen brightness is the one overlay that starts on: this laptop reports those keys but does not act on them, so OpenAorus changes the brightness and nothing else shows you that it did."/>
                    </StackPanel>

                    <!-- The same three-column footing as the sensor card above, so the two Save
                         buttons land in the same place. -->
                    <!-- The same three-column footing as the sensor card above, so the two Save
                         buttons land in the same place. -->
                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Muted}" Text="Overlay seconds" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding OverlaySeconds}"
                                     AutomationProperties.Name="Overlay seconds"/>
                        </StackPanel>
                        <Border/>
                        <!-- Named, because there are now two buttons in this dialog reading
                             "Save" and a screen reader would otherwise offer the same word
                             twice with nothing to tell them apart. -->
                        <Button Content="Save" VerticalAlignment="Bottom" Command="{Binding SaveCommand}"
                                AutomationProperties.Name="Save hotkey settings"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Muted}" Text="{Binding SettingsPath}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SettingsPath}" Margin="2,0,0,0"/>
            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Fg}" Text="{Binding Message}" Margin="2,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
