<UserControl x:Class="OpenAorus.App.Views.ContextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:OpenAorus.App"
             xmlns:views="clr-namespace:OpenAorus.App.Views">
    <UserControl.Resources>
        <app:EnumEqualsVisibilityConverter x:Key="EnumVis"/>
    </UserControl.Resources>
    <!-- Every state sizes to its own content. The card used to be stretched to the height
         the curve editor needs and then filled with one grey sentence for four of the six
         modes, which is where the window's dead area came from. -->
    <Grid>
        <!-- Fixed -->
        <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumVis}, ConverterParameter=Fixed}">
            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,4" Text="Fixed"/>
            <TextBlock Style="{StaticResource Body}" Text="One duty for both fans." Margin="0,0,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding FixedPercent}" x:Name="FixedSlider"
                        Thumb.DragCompleted="FixedSlider_DragCompleted" KeyUp="FixedSlider_KeyUp"/>
                <TextBlock Grid.Column="1" Width="46" Margin="10,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Text="{Binding FixedPercent, StringFormat={}{0}%}"/>
            </Grid>
            <TextBlock Style="{StaticResource Muted}" Text="Applied when you release the slider." Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Custom -->
        <views:CurveEditor x:Name="Editor" DataContext="{Binding Curve}"
                           Visibility="{Binding DataContext.SelectedMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumVis}, ConverterParameter=Custom}"/>

        <!-- Descriptions. The mode's name is lifted out of the sentence and set as the card's
             title, so the card says what it is about before it is read. -->
        <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumVis}, ConverterParameter=Quiet}">
            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,4" Text="Quiet"/>
            <TextBlock Style="{StaticResource Body}"
                       Text="Firmware fan table with the EC's 'quiet' bias. Lowest noise, thermals a little higher."/>
        </StackPanel>
        <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumVis}, ConverterParameter=Normal}">
            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,4" Text="Normal"/>
            <TextBlock Style="{StaticResource Body}" Text="The EC's default fan table."/>
        </StackPanel>
        <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumVis}, ConverterParameter=Gaming}">
            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,4" Text="Gaming"/>
            <TextBlock Style="{StaticResource Body}"
                       Text="EC auto mode with an aggressive table. What GCC calls Gaming / Power."/>
        </StackPanel>
        <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumVis}, ConverterParameter=Turbo}">
            <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,4" Text="Turbo"/>
            <TextBlock Style="{StaticResource Body}" Text="Both fans pinned at 100 %."/>
        </StackPanel>
    </Grid>
</UserControl>
