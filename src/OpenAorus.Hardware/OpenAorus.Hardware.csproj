<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <!-- mofcomp needs a path on disk and a single-file publish has no loose files, so both MOFs
       ship inside the assembly and are written out at registration time. LogicalName is stated
       rather than left to the SDK so that renaming the folder cannot silently change the name
       SchemaMof asks for. -->
  <ItemGroup>
    <EmbeddedResource Include="Wmi\Schema\GB_WMIACPI.mof" LogicalName="OpenAorus.Hardware.Wmi.Schema.GB_WMIACPI.mof" />
    <EmbeddedResource Include="Wmi\Schema\GB_WMIACPI-remove.mof" LogicalName="OpenAorus.Hardware.Wmi.Schema.GB_WMIACPI-remove.mof" />
  </ItemGroup>

  <!-- Gate A judges a fresh registration against a reading this machine has already produced, so
       the reference has to reach the owner's laptop and not only the test run. It travels inside
       the assembly for the same reason the MOFs do: the app publishes as a single file. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\research\dump-aorus-17g-kd-known-good.txt"
                      LogicalName="OpenAorus.Hardware.Wmi.Schema.dump-aorus-17g-kd-known-good.txt" />
  </ItemGroup>

</Project>
