[dynamic, provider("WmiProv"), WMI, guid("{ABBC0F6C-8EA1-11d1-00A0-C90629100000}"),
 Description("Class to test Query/Set Gigabyte WMI ACPI")]
class GB_WMIACPI_Data
{
    [read] boolean Active;
    [read, write, WmiDataId(1), Description("Read A ULONG value")] uint32 Data;
    [key, read] string InstanceName;
};

[dynamic, provider("WmiProv"), WMI, guid("{ABBC0F72-8EA1-11d1-00A0-C90629100000}"),
 Description("Class containing event generated ULong data")]
class GB_WMIACPI_Event : WMIEvent
{
    [read] boolean Active;
    [read, write, WmiDataId(1), MAX(4), Description("WMI Event Data")] uint8 Data[];
    [key, read] string InstanceName;
};

[Description("Written by OpenAorus when it registered the classes above. Its presence is how a later run tells our registration apart from a vendor one, and the fingerprint is the same string recomputed from the live classes.")]
class OpenAorus_SchemaMarker
{
    [key] string Id;
    string Fingerprint;
};

instance of OpenAorus_SchemaMarker
{
    Id = "OpenAorus";
    Fingerprint = "482f5601e0bed6ba4f417c4dae11e44fe69638b81aa81ed572bc2a24d0fda93d";
};
